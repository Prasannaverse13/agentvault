# Deployer / owner wallet (Mezo testnet, funded from https://faucet.test.mezo.org)
PRIVATE_KEY=

# Agent hot wallet (funded with testnet BTC, only allowed to protect vaults)
AGENT_PRIVATE_KEY=

# Optional: pre-existing vault (skip factory creation in agent)
VAULT_ADDRESS=
FACTORY_ADDRESS=

# Contracts (defaults are Mezo testnet, chain 31611)
MEZO_TESTNET_RPC=https://rpc.test.mezo.org

# Agent HTTP API
AGENT_PORT=8787
AGENT_SIMULATION=true

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM chat (optional; deterministic parser is used when absent)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Web
NEXT_PUBLIC_AGENT_URL=http://localhost:8787
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=31611
